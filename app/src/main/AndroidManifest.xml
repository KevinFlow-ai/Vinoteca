<?xml version="1.0" encoding="utf-8"?>
<!-- `manifest` declara permisos, componentes y metadatos base que
Android necesita para ejecutar Vinoteca. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- `uses-feature` declara que la cámara es opcional para que la app siga siendo instalable en más dispositivos. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- `uses-permission` mantiene el permiso necesario para capturar fotos desde la pantalla de bebidas. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- `application` define la configuración global de la app, incluyendo tema, icono y reglas de backup. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_vinoteca"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_vinoteca"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vinoteca"
        tools:targetApi="31">

        <!-- `activity` registra la actividad principal que aloja toda la UI Compose rediseñada. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Vinoteca">

            <!-- `intent-filter` marca esta actividad como punto de entrada lanzable desde el launcher del sistema. -->
            <intent-filter>

                <!-- `action MAIN` indica que esta es la entrada principal de la aplicación. -->
                <action android:name="android.intent.action.MAIN" />

                <!-- `category LAUNCHER` permite que la app aparezca en el cajón de aplicaciones. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- `provider` mantiene el FileProvider necesario para compartir ZIPs y servir imágenes internas de forma segura. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <!-- `meta-data` enlaza la configuración XML de rutas permitidas por el provider. -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
